# Neon Postgres (via Vercel Marketplace integration). Copia este archivo a
# .env.local y rellena con la connection string real — nunca subas .env.local
# al repositorio (ya está en .gitignore).
DATABASE_URL="postgres://usuario:password@host/base_de_datos?sslmode=require"

# Panel interno /admin/leads (protegido con Basic Auth). Elige tus propias
# credenciales — no tienen por qué coincidir con nada más.
ADMIN_USER="admin"
ADMIN_PASSWORD="cambia-esto-por-algo-seguro"
